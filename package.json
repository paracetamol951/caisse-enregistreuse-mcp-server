{
  "name": "caisse-enregistreuse-mcp-server",
  "version": "1.4.1",
  "description": "MCP server exposing kash.click API as tools",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "start:stdio": "node build/stdio.js",
    "start:http": "node build/index.js --http",
    "generate:manifest": "node scripts/generate-manifest.mjs",
    "test": "node tests/quick.test.mjs",
    "test:oauth": "node --import tsx --test tests/oauth-mcp.test.mjs",
    "start:fr": "MCP_LANG=fr node build/index.js",
    "start:en": "MCP_LANG=en node build/index.js",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "caisse-enregistreuse-mcp-server": "./build/cli.js"
  },
  "files": [
    "build",
    "static",
    "locales",
    "manifest.template.json",
    "scripts/generate-manifest.mjs",
    "doc/async-operations.md",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "ioredis": "^5.3.2",
    "jose": "^6.1.0",
    "undici": "^6.29.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
